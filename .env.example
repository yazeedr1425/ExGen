# ─────────── web app (Next.js) ───────────
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://xqlpilvtwaensdrakqpp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_v1j-LVUUDYw4_DCQuxQJ4w_n8aU8UDP

# ─────────── Supabase Edge Function secrets ───────────
# NOT part of this file at runtime — set these on the project, not in .env:
#   supabase secrets set --project-ref xqlpilvtwaensdrakqpp KEY=value
#
# XG_SHARED_SECRET        64-hex. Must match the n8n Variable of the same name.
# N8N_GENERATE_URL        production webhook URL of "XG · Generate Extension"
# N8N_HEADER_AUTH_NAME    header name the n8n webhook credential expects (x-xg-key)
# N8N_HEADER_AUTH_VALUE   header value the n8n webhook credential expects
# ALLOWED_ORIGIN          http://localhost:3000 in dev, your domain in prod
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# into Edge Functions automatically. Never set the service_role key anywhere the
# browser or n8n can read it.

# ─────────── local scripts only ───────────
# Used by scripts/test-callback.sh to sign a test payload.
XG_SHARED_SECRET=
